<%# for the flash notice if there is one%>
<% if notice %>
    <p><%= notice %></p>
<% end %>

<p style="color: green"><%= notice %></p> 

<h1>Books</h1> 
<h1>This is the authenticated version 2</h1> 

<h1>You're logged in! Welcome to the Dashboard!</h1> 
<%= link_to "Sign Out", destroy_admin_session_path %> 

<%= link_to "Add a Book", new_book_path %>

<%# list books with options for details and edit %>
<% if @books.any? %>
    <ul>
        <% @books.each do |book| %>
            <li>
                <strong><%= book.title %></strong>
                — Author: <%= book.author %>
                — Price: $<%= book.price %>
                — Published: <%= book.published_date %>

                <%= link_to "Show", book_path(book) %>
                <%= link_to "Edit", edit_book_path(book) %>
                <%= link_to "Delete", delete_book_path(book) %>
            </li>
        <% end %>
    </ul>
<% else %>
    <p>No books have been added yet.</p>
<% end %>